# Only run on macOS

if [[ "$OSTYPE" == "darwin"* ]]; then
	# needed for brew
	eval "$(/opt/homebrew/bin/brew shellenv)"
  export XDG_RUNTIME_DIR="$HOME"/Library/Caches/TemporaryItems
fi

export XDG_CONFIG_HOME="$HOME"/.config

# On Linux, SSH and other login shells read .zprofile but not .zshrc.
# Source .zshrc so the prompt, aliases, and tools always load.
# typeset -U path in .zshrc deduplicates PATH if this runs twice.
if [[ "$OSTYPE" != "darwin"* ]]; then
  [[ -f ~/.zshrc ]] && source ~/.zshrc
fi
